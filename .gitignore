# Byte-compiled / cache
__pycache__/
*.pyc

# PyInstaller build output
build/
dist/

# Packaged archives (published via GitHub Releases instead)
*.zip

# Runtime-generated user data (recreated automatically on first launch)
config.json
stats.json
dev_data/

# Ad-hoc local logs
*.log

# Pre-edit asset backups (scratch, not release content)
assets_backup/

# Editor/OS cruft
.idea/
.vscode/
Thumbs.db
